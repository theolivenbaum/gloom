<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Package metadata shared by every project that ships to NuGet. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Company>Curiosity GmbH</Company>
    <Authors>Curiosity GmbH and the gloom authors</Authors>
    <Product>Gloom</Product>
    <Description>Gloom: a high-performance cache-line blocked one-hashing bloom filter for .NET, a C# port of github.com/jcalabro/gloom. Single-threaded, lock-free atomic and sharded filters, xxh3-128 hashing, UID128 keys, and a serialization format compatible with the Go library.</Description>
    <Copyright>Copyright (c) 2026 Curiosity GmbH; Copyright (c) jcalabro</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>bloom-filter;bloom;probabilistic;xxh3;uid128;mosaik;curiosity</PackageTags>
    <PackageProjectUrl>https://github.com/theolivenbaum/gloom</PackageProjectUrl>
    <RepositoryUrl>https://github.com/theolivenbaum/gloom</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!-- The repository README is the package README on nuget.org (its links are absolute for that reason). -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
